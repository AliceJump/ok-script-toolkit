node_modules/
out/
*.vsix
*.log
.vscode-test/
# .vscode/ 只共享调试入口（F5 用的 launch.json、构建用的 tasks.json、推荐扩展）。
# 必须写 .vscode/* 而不是 .vscode/ —— git 无法在整目录被排除后重新纳入其中的文件。
# 其余（settings.json、本地状态等）保持本地不提交。
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
configs/
.vscodeignore
__pycache__
.workbuddy-ai
# 协作 agent 的本地工作记录（记忆/日志）。属于开发工具状态，不是项目内容 —— 只在本地留存。
.workbuddy/

# GIF 制作工具链的本地依赖（gifsicle 便携版，GPL-2.0 二进制，不进仓库）
.tools/

# 原子写的临时产物（写入中的 .tmp 与旧版备份）
*.ok-script-toolkit.tmp
*.bak

# 审查/修复计划类的一次性工作目录（verification-<日期> at <时间>/ 等）。
# 与 .vscodeignore 同一条规则 —— 每次审查都会新建一个带时间戳的目录，逐个列名必然漏。
verification-*/
verification */
# ok 脚本项目的模板目录（本仓库是扩展不是游戏项目）。⚠️ 空目录 git 不报 ??，
# 曾长期潜伏：一旦有文件落进去就会被 `git add .` 扫进来。
ok_templates/
