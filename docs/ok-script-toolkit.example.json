{
  "$schema": "https://raw.githubusercontent.com/AliceJump/ok-script-toolkit/main/schemas/ok-script-toolkit.schema.json",

  "labelEnum": {
    "path": "src/data/FeatureList",
    "name": "FeatureList",
    "aliases": ["fL"]
  },

  "executor": {
    "startupHooks": {
      "beforeConfigImport": [
        "src.patches.pre_config_patch:install_pre_config_patch",
        "src.patches.qfluent_mute_promo_patch:install_mute_promo_patch"
      ],
      "afterConfigImport": [
        "src.patches.startup_patches:install_startup_patches"
      ]
    }
  },

  "templates": {
    "directory": "ok_templates",
    "cocoAnnotations": "assets/coco_annotations.json"
  },

  "i18n": {
    "enabled": true,
    "langDirectory": "assets/lang",
    "poDirectory": "i18n",
    "poDomains": ["ocr"]
  },

  "characters": {
    "projectPath": "",
    "masterFile": "assets/data/characters.json",
    "skillsDirectory": "assets/data/character_skills",
    "localeFile": "assets/lang/characters.json",
    "avatarTemplateRegex": "^battle[_-]?icon[_-]?"
  },

  "effects": {
    "file": "src/data/effects.py"
  }
}
