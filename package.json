{
  "name": "ok-script-toolkit",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.11.0",
  "publisher": "AliceJump",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AliceJump/ok-script-toolkit.git"
  },
  "homepage": "https://github.com/AliceJump/ok-script-toolkit#readme",
  "bugs": {
    "url": "https://github.com/AliceJump/ok-script-toolkit/issues"
  },
  "keywords": [
    "ok-script",
    "python",
    "localization",
    "inlay hints",
    "FeatureList",
    "template matching"
  ],
  "galleryBanner": {
    "color": "#172554",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "okScriptToolkit.showTemplates",
        "title": "%command.showTemplates%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.openTemplatesEditor",
        "title": "%command.openTemplatesEditor%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.showTaskLauncher",
        "title": "%command.showTaskLauncher%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.openCharacterManager",
        "title": "%command.openCharacterManager%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.openTemplateAssets",
        "title": "%command.openTemplateAssets%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.openAnnotationEditor",
        "title": "%command.openAnnotationEditor%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.showTempScreenshots",
        "title": "%command.showTempScreenshots%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.screenshotToTemplate",
        "title": "%command.screenshotToTemplate%",
        "category": "%command.category%"
      },
      {
        "command": "okScriptToolkit.showConventionSources",
        "title": "%command.showConventionSources%",
        "category": "%command.category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "okTools",
          "title": "%viewContainer.tools.title%",
          "icon": "media/icons/toolbox.svg"
        },
        {
          "id": "okTemplates",
          "title": "%viewContainer.templates.title%",
          "icon": "media/icons/templates.svg"
        },
        {
          "id": "okTempShots",
          "title": "%viewContainer.tempShots.title%",
          "icon": "media/icons/tempShots.svg"
        }
      ]
    },
    "views": {
      "okTools": [
        {
          "type": "webview",
          "id": "okScriptToolkit.console",
          "name": "%view.console%",
          "title": "%view.console.title%",
          "icon": "media/icons/toolbox.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        }
      ],
      "okTemplates": [
        {
          "type": "webview",
          "id": "okScriptToolkit.templateGallery",
          "name": "%view.templateGallery%",
          "title": "%view.templateGallery.title%",
          "icon": "media/icons/templates.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        },
        {
          "type": "webview",
          "id": "okScriptToolkit.templateAssets",
          "name": "%view.templateAssets%",
          "title": "%view.templateAssets.title%",
          "icon": "media/icons/templates.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        }
      ],
      "okTempShots": [
        {
          "type": "webview",
          "id": "okScriptToolkit.tempScreenshots",
          "name": "%view.tempScreenshots%",
          "title": "%view.tempScreenshots.title%",
          "icon": "media/icons/tempShots.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        }
      ]
    },
    "keybindings": [
      {
        "command": "okScriptToolkit.showTemplates",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == python"
      },
      {
        "command": "okScriptToolkit.screenshotToTemplate",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "okScriptToolkit.langDirectory": {
          "type": "string",
          "default": "assets/lang",
          "description": "%config.langDirectory%"
        },
        "okScriptToolkit.poDirectory": {
          "type": "string",
          "default": "i18n",
          "description": "%config.poDirectory%"
        },
        "okScriptToolkit.enablePoData": {
          "type": "boolean",
          "default": true,
          "description": "%config.enablePoData%"
        },
        "okScriptToolkit.poDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ocr"
          ],
          "description": "%config.poDomains%"
        },
        "okScriptToolkit.displayLocale": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh_CN",
            "zh_TW",
            "en_US",
            "ja_JP",
            "ko_KR",
            "es_ES"
          ],
          "description": "%config.displayLocale%"
        },
        "okScriptToolkit.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableInlayHints%"
        },
        "okScriptToolkit.featureAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "fL",
            "FeatureList"
          ],
          "description": "%config.featureAliases%"
        },
        "okScriptToolkit.labelEnumPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.labelEnumPath%"
        },
        "okScriptToolkit.labelEnumName": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.labelEnumName%"
        },
        "okScriptToolkit.effectsFile": {
          "type": "string",
          "default": "src/data/effects.py",
          "description": "%config.effectsFile%"
        },
        "okScriptToolkit.okScriptProjectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.okScriptProjectPath%"
        },
        "okScriptToolkit.okScriptPython": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.okScriptPython%"
        },
        "okScriptToolkit.captureMethod": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "wgc",
            "bitblt",
            "foreground"
          ],
          "markdownDescription": "%config.captureMethod%"
        },
        "okScriptToolkit.characterProjectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.characterProjectPath%"
        },
        "okScriptToolkit.characterMasterFile": {
          "type": "string",
          "default": "assets/data/characters.json",
          "description": "%config.characterMasterFile%"
        },
        "okScriptToolkit.characterSkillsDirectory": {
          "type": "string",
          "default": "assets/data/character_skills",
          "description": "%config.characterSkillsDirectory%"
        },
        "okScriptToolkit.characterLocaleFile": {
          "type": "string",
          "default": "assets/lang/characters.json",
          "description": "%config.characterLocaleFile%"
        },
        "okScriptToolkit.characterAvatarTemplateRegex": {
          "type": "string",
          "default": "^battle[_-]?icon[_-]?",
          "description": "%config.characterAvatarTemplateRegex%"
        },
        "okScriptToolkit.okTemplatesDirectory": {
          "type": "string",
          "default": "ok_templates",
          "description": "%config.okTemplatesDirectory%"
        },
        "okScriptToolkit.annotationKeybindings": {
          "type": "object",
          "default": {
            "drawBbox": "r",
            "copyCoords": "c",
            "deleteMode": "d",
            "undo": "ctrl+z",
            "redo": "ctrl+y",
            "copy": "ctrl+c",
            "paste": "ctrl+v",
            "deleteSelected": "Delete",
            "prevImage": "ArrowLeft",
            "nextImage": "ArrowRight"
          },
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.annotationKeybindings%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "ok-script-toolkit.json",
        "url": "./schemas/ok-script-toolkit.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "version:sync": "node scripts/release/sync-version.js",
    "verify:version": "node scripts/release/verify-version.js",
    "verify:l10n": "node scripts/release/verify-l10n.js",
    "release": "sh scripts/release.sh",
    "test": "npm run verify:version && npm run verify:l10n && npm run compile && npm run test:webview-html && npm run test:task-launcher && npm run test:task-launcher-executor && npm run test:temp-screenshots && npm run test:annotation-coords && npm run test:thumb-content-hash && npm run test:list-editor && npm run test:project-config && npm run test:project-config-schema && npm run test:convention-sources && npm run test:label-enum-guard && npm run test:save-to-assets-flow && npm run test:save-to-assets && npm run test:asset-pack-worker && npm run test:coco-feature-path && npm run test:probe-schemas && npm run test:probe-window-config && npm run test:run-sandbox && npm run test:startup-patches && npm run test:executor-project-config",
    "test:webview-html": "node scripts/test_webview_html.js",
    "test:task-launcher": "node scripts/test_task_launcher_subconfigs.js",
    "test:task-launcher-executor": "node scripts/test_task_launcher_executor.js",
    "test:temp-screenshots": "node scripts/test_temp_screenshots.js",
    "test:annotation-coords": "node scripts/test_annotation_coords.js",
    "test:thumb-content-hash": "node scripts/test_thumb_content_hash.js",
    "test:list-editor": "node scripts/test_list_editor_display.js",
    "test:project-config": "node scripts/test_project_config.js",
    "test:project-config-schema": "node scripts/test_project_config_schema.js",
    "test:convention-sources": "node scripts/test_convention_sources.js",
    "test:label-enum-guard": "node scripts/test_label_enum_guard.js",
    "test:save-to-assets-flow": "node scripts/test_save_to_assets_flow.js",
    "test:coco-feature-path": "node scripts/test_coco_feature_path.js",
    "test:save-to-assets": "node scripts/test_save_to_assets.js",
    "test:asset-pack-worker": "node scripts/test_asset_pack_worker.js",
    "test:probe-schemas": "python python/tests/test_probe_pure_group_labels.py",
    "test:probe-window-config": "python python/tests/test_probe_window_config.py",
    "test:run-sandbox": "python python/tests/test_run_executor_sandbox.py",
    "test:startup-patches": "python python/tests/test_run_executor_startup_patches.py",
    "test:executor-project-config": "python python/tests/test_run_executor_project_config.py",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:marketplace": "vsce publish --skip-duplicate --packagePath ok-script-toolkit-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4"
  }
}
