{
  "name": "ok-lang-hints",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.6.0",
  "publisher": "AliceJump",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AliceJump/ok-lang-hints.git"
  },
  "homepage": "https://github.com/AliceJump/ok-lang-hints#readme",
  "bugs": {
    "url": "https://github.com/AliceJump/ok-lang-hints/issues"
  },
  "keywords": [
    "ok-script",
    "python",
    "localization",
    "inlay hints",
    "FeatureList",
    "template matching"
  ],
  "galleryBanner": {
    "color": "#172554",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "okLangHints.showTemplates",
        "title": "%command.showTemplates%",
        "category": "%command.category%"
      },
      {
        "command": "okLangHints.openTemplatesEditor",
        "title": "%command.openTemplatesEditor%",
        "category": "%command.category%"
      },
      {
        "command": "okLangHints.showTaskLauncher",
        "title": "%command.showTaskLauncher%",
        "category": "%command.category%"
      },
      {
        "command": "okLangHints.openCharacterManager",
        "title": "%command.openCharacterManager%",
        "category": "%command.category%"
      },
      {
        "command": "okLangHints.openTemplateAssets",
        "title": "%command.openTemplateAssets%",
        "category": "%command.category%"
      },
      {
        "command": "okLangHints.openAnnotationEditor",
        "title": "%command.openAnnotationEditor%",
        "category": "%command.category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "okLangHints",
          "title": "%viewContainer.title%",
          "icon": "media/icons/templates.svg"
        }
      ]
    },
    "views": {
      "okLangHints": [
        {
          "type": "webview",
          "id": "okLangHints.templateGallery",
          "name": "%view.templateGallery%",
          "icon": "media/icons/templates.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        },
        {
          "type": "webview",
          "id": "okLangHints.taskLauncher",
          "name": "%view.taskLauncher%",
          "icon": "media/icons/task.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        },
        {
          "type": "webview",
          "id": "okLangHints.toolbox",
          "name": "%view.toolbox%",
          "icon": "media/icons/toolbox.svg"
        },
        {
          "type": "webview",
          "id": "okLangHints.templateAssets",
          "name": "%view.templateAssets%",
          "icon": "media/icons/templates.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        }
      ]
    },
    "keybindings": [
      {
        "command": "okLangHints.showTemplates",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == python"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "okLangHints.langDirectory": {
          "type": "string",
          "default": "assets/lang",
          "description": "%config.langDirectory%"
        },
        "okLangHints.poDirectory": {
          "type": "string",
          "default": "i18n",
          "description": "%config.poDirectory%"
        },
        "okLangHints.enablePoData": {
          "type": "boolean",
          "default": true,
          "description": "%config.enablePoData%"
        },
        "okLangHints.poDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ocr"
          ],
          "description": "%config.poDomains%"
        },
        "okLangHints.displayLocale": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh_CN",
            "zh_TW",
            "en_US",
            "ja_JP",
            "ko_KR",
            "es_ES"
          ],
          "description": "%config.displayLocale%"
        },
        "okLangHints.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableInlayHints%"
        },
        "okLangHints.featureAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "fL",
            "FeatureList"
          ],
          "description": "%config.featureAliases%"
        },
        "okLangHints.effectsFile": {
          "type": "string",
          "default": "src/data/effects.py",
          "description": "%config.effectsFile%"
        },
        "okLangHints.okScriptProjectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.okScriptProjectPath%"
        },
        "okLangHints.okScriptPython": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.okScriptPython%"
        },
        "okLangHints.characterProjectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.characterProjectPath%"
        },
        "okLangHints.characterMasterFile": {
          "type": "string",
          "default": "assets/data/characters.json",
          "description": "%config.characterMasterFile%"
        },
        "okLangHints.characterSkillsDirectory": {
          "type": "string",
          "default": "assets/data/character_skills",
          "description": "%config.characterSkillsDirectory%"
        },
        "okLangHints.characterLocaleFile": {
          "type": "string",
          "default": "assets/lang/characters.json",
          "description": "%config.characterLocaleFile%"
        },
        "okLangHints.characterAvatarTemplateRegex": {
          "type": "string",
          "default": "^battle[_-]?icon[_-]?",
          "description": "%config.characterAvatarTemplateRegex%"
        },
        "okLangHints.okTemplatesDirectory": {
          "type": "string",
          "default": "ok_templates",
          "description": "%config.okTemplatesDirectory%"
        },
        "okLangHints.annotationKeybindings": {
          "type": "object",
          "default": {
            "drawBbox": "r",
            "deleteMode": "d",
            "undo": "ctrl+z",
            "redo": "ctrl+y",
            "copy": "ctrl+c",
            "paste": "ctrl+v",
            "deleteSelected": "Delete",
            "prevImage": "ArrowLeft",
            "nextImage": "ArrowRight"
          },
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.annotationKeybindings%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "version:sync": "node scripts/release/sync-version.js",
    "verify:version": "node scripts/release/verify-version.js",
    "release": "node scripts/release/release.js",
    "test": "npm run verify:version && npm run compile && npm run test:task-launcher",
    "test:task-launcher": "node scripts/test_task_launcher_subconfigs.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:marketplace": "vsce publish --skip-duplicate --packagePath ok-lang-hints-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.0"
  }
}
